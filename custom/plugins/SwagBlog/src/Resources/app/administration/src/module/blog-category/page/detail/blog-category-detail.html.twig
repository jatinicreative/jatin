<sw-page>
    <template #smart-bar-header>
        <h2>{{ isNew ? 'Create' : 'Edit' }} Blog Category</h2>
    </template>

    <template #smart-bar-actions>
        <sw-button @click="onCancel">Cancel</sw-button>
        <sw-button-process
                :is-loading="isLoading"
                v-model:process-success="isSaveSuccessful"
                variant="primary"
                @click="onSave"
        >
            Save
        </sw-button-process>
    </template>

    <template #language-switch>
        <sw-language-switch
                :save-changes-function="saveOnLanguageChange"
                @on-change="onChangeLanguage"
        >
        </sw-language-switch>
    </template>

    <template #content>
        <sw-card title="General" v-if="blogCategory">
            <sw-text-field
                    v-model:value="blogCategory.name"
                    label="Name"
                    required
            >
            </sw-text-field>
        </sw-card>
    </template>
</sw-page>