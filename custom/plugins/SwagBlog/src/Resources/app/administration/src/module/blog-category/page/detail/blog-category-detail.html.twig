<sw-page>
    <template #smart-bar-header>
        <h2>{{ isNew ? 'Create' : 'Edit' }} Blog Category</h2>
    </template>

    <template #smart-bar-actions>

        <sw-button @click="onCancel">
            Cancel
        </sw-button>

        <sw-button-process
                v-model:process-success="isSaveSuccessful"
                :is-loading="isLoading"
                variant="primary"
                @click.prevent="onSave"
        >
            Save
        </sw-button-process>
    </template>

    <template #language-switch>
        <sw-language-switch
                :save-changes-function="saveOnLanguageChange"
                @on-change="onChangeLanguage"
        >
        </sw-language-switch>
    </template>

    <template #content>

        <sw-card title="General" v-if="blogCategory">
            <label for="category-name">Name</label>
            <sw-text-field id="category-name" v-model="blogCategory.name" class="sw-field__input" />
        </sw-card>
    </template>
</sw-page>