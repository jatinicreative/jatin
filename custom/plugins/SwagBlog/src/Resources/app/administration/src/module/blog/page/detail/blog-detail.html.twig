<sw-page>
    <template #smart-bar-header>
        <h2>{{ isNew ? 'Create' : 'Edit' }} Blog</h2>
    </template>

    <template #smart-bar-actions>
        <sw-button @click="onCancel">Cancel</sw-button>
        <sw-button-process
                :is-loading="isLoading"
                v-model:process-success="isSaveSuccessful"
                variant="primary"
                @click="onSave"
        >
            Save
        </sw-button-process>
    </template>

    <template #language-switch>
        <sw-language-switch
                :save-changes-function="saveOnLanguageChange"
                @on-change="onChangeLanguage"
        />
    </template>

    <template #content>
        <sw-card title="General" v-if="blog">
            <sw-text-field
                    v-model:value="blog.name"
                    label="Name"
                    required
            />
            <sw-textarea-field
                    v-model:value="blog.description"
                    label="Description"
            />
            <sw-switch-field
                    v-model:value="blog.active"
                    label="Active"
            />
            <sw-text-field
                    v-model:value="blog.author"
                    label="Author"
            />
            <sw-datepicker
                    v-model:value="blog.releaseDate"
                    label="Release Date"
            />
            <sw-entity-multi-select
                    v-model:entityCollection="blog.categories"
                    :criteria="categoryCriteria"
                    entity="blog_category"
                    label="Blog Categories"
            />

            <sw-entity-multi-select
                    v-model:entityCollection="blog.products"
                    :criteria="productCriteria"
                    entity="product"
                    label="Products"
            />

        </sw-card>
    </template>
</sw-page>
