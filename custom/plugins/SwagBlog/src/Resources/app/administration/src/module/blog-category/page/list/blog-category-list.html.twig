<sw-page>
    <template #search-bar>
        <sw-search-bar
                initial-search-type="Blog Categories"
                :initial-search="term"
                @search="onSearch"
        >
        </sw-search-bar>
    </template>

    <template #smart-bar-header>
        <h2>Blog Categories</h2>
    </template>

    <template #smart-bar-actions>
        <sw-button @click="onCreateNewCategory" variant="primary">
            Create New Category
        </sw-button>
    </template>

    <template #language-switch>
        <sw-language-switch @on-change="onChangeLanguage" >
        </sw-language-switch>
    </template>

    <template #content>
        <div>
            <sw-entity-listing
                    detail-route="blog.category.detail"
                    :is-loading="isLoading"
                    :columns="blogCategoryColumns"
                    :repository="blogCategoryRepository"
                    :items="blogCategories"
            >
            </sw-entity-listing>
        </div>
    </template>
</sw-page>
