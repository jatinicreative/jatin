<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
           http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="CustomerRegistrationExtension\Service\CustomerGroupService">
            <argument type="service" id="customer_group.repository"/>
        </service>

        <service id="CustomerRegistrationExtension\Subscriber\RegistrationFormSubscriber">
            <tag name="kernel.event_subscriber"/>
            <argument type="service" id="CustomerRegistrationExtension\Service\CustomerGroupService"/>
        </service>

        <service id="CustomerRegistrationExtension\Controller\CustomerGroupSearchController">
            <argument type="service" id="customer_group.repository"/>
            <tag name="controller.service_arguments"/>
            <call method="setContainer">
                <argument id="service_container" type="service" />
            </call>

        </service>
    </services>
</container>