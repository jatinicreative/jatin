{% sw_extends '@Storefront/storefront/component/account/register.html.twig' %}


{% block component_account_register_personal_address_fields %}
{{ parent() }}

    <div class="form-group">
        <label for="customerGroup">Customer Group</label>
        <select name="customCustomerGroup" id="customerGroup" class="form-control" required>
            <option value="">Please select</option>
            {% for group in page.extensions.customCustomerGroups.groups %}
                <option value="{{ group.id }}">{{ group.name }}</option>
            {% endfor %}
        </select>
    </div>

    <div class="form-group">
        <label for="customerGroupSearch">Search Customer Group</label>
        <input type="text"
               id="customerGroupSearch"
               class="form-control"
               placeholder="3 characters needed"
               data-base-url="{{ app.request.schemeAndHttpHost ~ app.request.basePath }}"
               data-customer-group-search />
    </div>
{% endblock %}